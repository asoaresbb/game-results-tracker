#!/bin/sh

gcc mainA.c -o exerciseA.exe

input_data=$(cat <<EOF
Pierre Zimmermann
Piotr Gawrys
Michal Klukowski
Bauke Muller
EOF
)
expected_output="4 57"

output_data=$(echo "$input_data" | ./exerciseA.exe)
if [ "$expected_output" = "$output_data" ]; then
    echo "Test passed! ✅ "
else
    echo "Test failed! ❌ "
    echo "  Expected: $expected_output"
    echo "  Actual  : $output_data"
    exit 1
fi
rm exerciseA.exe
