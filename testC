#!/bin/sh

gcc mainC.c -o exerciseC.exe

input_data=$(cat <<EOF
Pierre Zimmermann
Piotr Gawrys
Michal Klukowski
Bauke Muller

Pierre Zimmermann: 10
Piotr Gawrys: 6
Michal Klukowski: 14
Bauke Muller: 7

Pierre Zimmermann: 1
Piotr Gawrys: 2
Michal Klukowski: 3
Bauke Muller: 4

Pierre Zimmermann: 4
Piotr Gawrys: 2
Michal Klukowski: 4
Bauke Muller: 3
EOF
)

expected_output=$(cat <<EOF
Pierre Zimmermann - 15 pontos, 1 vitorias.
Piotr Gawrys - 10 pontos, 0 vitorias.
Michal Klukowski - 21 pontos, 2 vitorias.
Bauke Muller - 14 pontos, 1 vitorias.
EOF
)

output_data=$(echo "$input_data" | ./exerciseC.exe)
if [ "$expected_output" != "$output_data" ]; then
    echo "  --- Expected -------------"
    echo "$expected_output"
    echo "  --- Actual ---------------"
    echo "$output_data"
    exit 1
fi
rm exerciseC.exe
