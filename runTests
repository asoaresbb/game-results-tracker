#!/bin/sh

passed_tests=0
failed_tests=0

test_scripts=$(ls test* 2>/dev/null)
for script in $test_scripts; do
  echo "Running $script..."
  if sh "$script"; then
    echo "Test passed! ✅ "
    passed_tests=$((passed_tests + 1))
  else
    echo "Test failed! ❌ "
    failed_tests=$((failed_tests + 1))
  fi
  echo "------------------------"
done

echo "$passed_tests tests passed | $failed_tests tests failed"

if [ "$failed_tests" -gt 0 ]; then
  exit 1
fi